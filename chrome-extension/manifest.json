{
  "manifest_version": 3,
  "name": "営業OS Bridge",
  "version": "1.1.0",
  "description": "X/Twitterのアカウントをクリップボード経由でOS⓪へ送る",

  "permissions": [],

  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content/twitter_scraper.js"],
      "css": ["content/twitter.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "営業OS Bridge"
  }
}
