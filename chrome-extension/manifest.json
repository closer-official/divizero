{
  "manifest_version": 3,
  "name": "営業OS Bridge",
  "version": "1.2.0",
  "description": "X/TwitterのユーザーをOS⓪プロンプトに変換してGeminiへ送る",

  "permissions": ["storage", "tabs"],

  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://divizero.vercel.app/*",
    "http://localhost:5173/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content/twitter_scraper.js"],
      "css": ["content/twitter.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "営業OS Bridge"
  }
}
